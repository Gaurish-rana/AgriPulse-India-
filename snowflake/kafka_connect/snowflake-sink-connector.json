{
  "name": "snowflake-sink-mandi-clean",
  "config": {
    "connector.class": "com.snowflake.kafka.connector.SnowflakeSinkConnector",
    "tasks.max": "1",
    "topics": "mandi-prices-clean",
    "snowflake.url.name": "${file:/tmp/snowflake_auth.properties:account}.snowflakecomputing.com:443",
    "snowflake.user.name": "${file:/tmp/snowflake_auth.properties:user}",
    "snowflake.private.key": "${file:/tmp/snowflake_auth.properties:private_key}",
    "snowflake.database.name": "AGRIPULSE_DB",
    "snowflake.schema.name": "CLEAN",
    "snowflake.topic2table.map": "mandi-prices-clean:CLEAN_MANDI_PRICES",
    "buffer.count.records": "500",
    "buffer.flush.time": "10",
    "buffer.size.bytes": "5000000",
    "key.converter": "org.apache.kafka.connect.storage.StringConverter",
    "value.converter": "org.apache.kafka.connect.json.JsonConverter",
    "value.converter.schemas.enable": "false",
    "errors.tolerance": "all",
    "errors.deadletterqueue.topic.name": "mandi-prices-dlq",
    "errors.deadletterqueue.context.headers.enable": "true",
    "snowflake.role.name": "ACCOUNTADMIN"
  }
}
