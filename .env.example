# ── Mandi API (data.gov.in) ─────────────────────────────────────────────────
MANDI_API_KEY=your_api_key_here
MANDI_API_BASE_URL=https://api.data.gov.in/resource/9ef84268-d588-465a-a308-a864a43d0070

# ── NASA POWER API ────────────────────────────────────────────────────────────
# No API key required for NASA POWER; base URL only
NASA_POWER_BASE_URL=https://power.larc.nasa.gov/api/temporal/daily/point

# ── ClickHouse Open-Source DWH (Phase 3) ──────────────────────────────────────
CLICKHOUSE_HOST=localhost
CLICKHOUSE_PORT=8123
CLICKHOUSE_NATIVE_PORT=9000
CLICKHOUSE_USER=default
CLICKHOUSE_PASSWORD=
CLICKHOUSE_DB_RAW=agripulse_raw
CLICKHOUSE_DB_CLEAN=agripulse_clean
CLICKHOUSE_DB_MART=agripulse_mart

# ── Snowflake (Optional Cloud) ───────────────────────────────────────────────
SNOWFLAKE_ACCOUNT=your_account_identifier  # e.g., xy12345.ap-south-1.aws or org-account
SNOWFLAKE_USER=your_username
SNOWFLAKE_PASSWORD=your_password
SNOWFLAKE_DATABASE=AGRIPULSE_DB
SNOWFLAKE_SCHEMA=CLEAN
SNOWFLAKE_WAREHOUSE=COMPUTE_WH
SNOWFLAKE_ROLE=ACCOUNTADMIN

# ── Kafka (Phase 2) ───────────────────────────────────────────────────────────
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
KAFKA_TOPIC_MANDI=agripulse.mandi.prices

# ── Logging ───────────────────────────────────────────────────────────────────
LOG_LEVEL=INFO
LOG_DIR=logs
